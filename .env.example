# WalletConnect Cloud project ID (required for production builds and WalletConnect wallets).
# Create one at https://cloud.walletconnect.com and allow your app origin.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=637b0f1903cc330a2251e6e88f187e33

# Optional: dedicated Robinhood Chain RPC (public endpoint is rate-limited).
# NEXT_PUBLIC_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Supabase (required for social feed, follows, and realtime).
# Create a project at https://supabase.com, run supabase/migrations/001_social_feed.sql,
# then paste the project URL and publishable key below. Add SUPABASE_SERVICE_ROLE_KEY to
# .env.local only (server-side writes); never commit the service role key.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key also works: NEXT_PUBLIC_SUPABASE_ANON_KEY=
